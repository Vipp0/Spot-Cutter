/* ═══════════════════════════════════════════════════════════════════════
   style.qss — Spot Cutter
   Tutta la grafica dell'applicazione. I colori vengono dal logo:

     blu notte   #1D3B53   testi forti, pulsanti principali, barra del video
     arancio     #E8541E   UN solo accento: Avvia e l'avanzamento totale
     inchiostro  #1F2933   testo            #52606D  testo secondario
     grigio      #8592A0   note             #E4E7EB  bordi
     fondo       #F5F6F8   pagina           #FFFFFF  pannelli e card

   Regole: superfici piatte, bordi sottili, niente maiuscolo gridato,
   un solo pulsante "pieno" arancione in tutta la finestra.
   ═══════════════════════════════════════════════════════════════════════ */

* {
    font-family: 'Segoe UI Variable Text', 'Segoe UI', system-ui;
}

/* ── FINESTRA E SFONDI ─────────────────────────────────────────────────── */
QMainWindow,
QWidget#central,
QWidget#main_area {
    background-color: #F5F6F8;
}

QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E7EB;
}

QToolTip {
    background-color: #1D3B53;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
    font-size: 12px;
}

/* ── INTESTAZIONI ──────────────────────────────────────────────────────── */
QLabel#app_title,
QLabel#main_title {
    color: #1D3B53;
    font-size: 22px;
    font-weight: 700;
    font-family: 'Segoe UI Variable Display', 'Segoe UI';
}

/* ── ETICHETTE GENERICHE ───────────────────────────────────────────────── */
QLabel#lbl_section {
    color: #8592A0;
    font-size: 11px;
    font-weight: 600;
    padding-top: 6px;
    padding-bottom: 2px;
}

QLabel#lbl_progress {
    color: #52606D;
    font-size: 12px;
    font-weight: 600;
}

QLabel#lbl_stat_sidebar {
    color: #52606D;
    font-size: 12px;
    font-weight: 600;
}

QLabel#lbl_stat_main {
    color: #1F2933;
    font-size: 12px;
}

QLabel#lbl_empty_queue {
    color: #8592A0;
    font-size: 14px;
    padding: 48px;
}

/* ── BARRA STATISTICHE IN ALTO ─────────────────────────────────────────── */
QWidget#stats_bar {
    background-color: #FFFFFF;
    border-radius: 10px;
    border: 1px solid #E4E7EB;
}

/* Un colore per categoria, tutti leggibili su bianco */
QLabel#lbl_stat_spot         { color: #1E8449; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_promo        { color: #A9710B; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_bumper       { color: #0E7490; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_annunci      { color: #9B3FA5; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_natale       { color: #C0392B; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_cartelli     { color: #5F6B7A; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_videosigle   { color: #6B4FC4; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_telegiornali { color: #B5560A; font-weight: 600; font-size: 13px; }
QLabel#lbl_stat_other        { color: #8592A0; font-weight: 600; font-size: 13px; }

/* ── CAMPI DI TESTO ────────────────────────────────────────────────────── */
QLineEdit {
    border: 1px solid #CBD2D9;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    background: #FFFFFF;
    color: #1F2933;
    selection-background-color: #1D3B53;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #1D3B53;
}

/* Barra unica YouTube: campo + tasto incolla attaccati */
QLineEdit#yt_entry {
    height: 36px;
    border-right: none;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    margin: 0px;
}

QPushButton#btn_paste {
    background-color: #FFFFFF;
    border: 1px solid #CBD2D9;
    border-left: 1px solid #E4E7EB;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    color: #52606D;
    font-family: "Segoe Fluent Icons", "Segoe UI Symbol";
    font-size: 14px;
    margin: 0px;
    padding: 0px;
}

QPushButton#btn_paste:hover {
    background-color: #F0F3F6;
    color: #1D3B53;
}

QPushButton#btn_paste:pressed {
    background-color: #E4E7EB;
}

/* ── SEPARATORI ─────────────────────────────────────────────────────────── */
QFrame#separator {
    color: #EEF0F3;
    background-color: #EEF0F3;
    max-height: 1px;
    border: none;
}

/* ── PULSANTI DELLA BARRA LATERALE ─────────────────────────────────────── */

/* Importa da YouTube: pulsante principale della sua sezione, blu notte */
QPushButton#btn_yt_left {
    background-color: #1D3B53;
    color: #FFFFFF;
    border: none;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border-right: 1px solid #35536C;
    font-size: 13px;
    font-weight: 600;
    min-height: 40px;
}

QPushButton#btn_yt_right {
    background-color: #1D3B53;
    color: #FFFFFF;
    border: none;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 40px;
    font-family: "Segoe Fluent Icons", "Segoe UI Symbol";   /* l'icona di download */
}

QPushButton#btn_yt_left:hover,
QPushButton#btn_yt_right:hover {
    background-color: #2A4D6A;
}

QPushButton#btn_yt_left:disabled,
QPushButton#btn_yt_right:disabled {
    background-color: #E4E7EB;
    color: #8592A0;
    border-right: 1px solid #D5DAE0;
}

/* Sfoglia / Aggiungi: pulsanti tenui */
QPushButton#btn_folder,
QPushButton#btn_files {
    background-color: #EEF2F6;
    color: #1D3B53;
    border: 1px solid #DCE3EA;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#btn_folder:hover,
QPushButton#btn_files:hover {
    background-color: #E2E9F0;
    border-color: #C5D0DB;
}

/* Svuota coda, Libreria, Storico, Impostazioni: voci leggere */
QPushButton#btn_clear,
QPushButton#btn_work_dir,
QPushButton#btn_storico,
QPushButton#btn_settings {
    background-color: transparent;
    border: 1px solid transparent;
    color: #52606D;
    font-size: 13px;
    font-weight: 400;
    border-radius: 8px;
    min-height: 34px;
    text-align: left;
    padding: 0 12px;
}
QPushButton#btn_clear:hover,
QPushButton#btn_work_dir:hover,
QPushButton#btn_storico:hover,
QPushButton#btn_settings:hover {
    background-color: #F0F3F6;
    color: #1F2933;
}
QPushButton#btn_clear:hover {
    background-color: #FCEBEA;
    color: #B3261E;
}
QPushButton#btn_clear:disabled {
    color: #B8C0C9;
    background-color: transparent;
}

/* AVVIA: l'unico pulsante arancione della finestra */
QPushButton#btn_run {
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
    min-height: 52px;
}
QPushButton#btn_run[stato="pronto"] {
    background-color: #E8541E;
}
QPushButton#btn_run[stato="pronto"]:hover {
    background-color: #D24612;
}
QPushButton#btn_run[stato="pronto"]:pressed {
    background-color: #BC3D0E;
}
QPushButton#btn_run[stato="disabilitato"],
QPushButton#btn_run:disabled {
    background-color: #E4E7EB;
    color: #8592A0;
}

QPushButton#btn_stop {
    background-color: #FFFFFF;
    color: #B3261E;
    border: 2px solid #B3261E;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    min-height: 45px;
}
QPushButton#btn_stop:hover {
    background-color: #B3261E;
    color: #FFFFFF;
}

/* ── CODA VIDEO ─────────────────────────────────────────────────────────── */
QScrollArea#queue_scroll {
    background-color: transparent;
    border: none;
}

QWidget#queue_container {
    background-color: #F5F6F8;
}

/* ── VIDEO CARD ─────────────────────────────────────────────────────────── */
QFrame#VideoCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EB;
    border-radius: 10px;
}

QFrame#VideoCard:hover {
    border-color: #B9C4CF;
}

QLabel#badge_index {
    color: #8592A0;
    font-weight: 600;
    font-size: 12px;
}

QLabel#card_title {
    color: #1F2933;
    font-weight: 600;
    font-size: 14px;
}

/* Pillola doppia TXT + DATA: i colori li decide il codice secondo lo stato */
QLabel#pill_part_txt {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    margin-right: 0px;
}

QLabel#pill_part_date {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    margin-left: 0px;
}

/* Pulsanti della card: tondi e discreti, si colorano al passaggio */
QPushButton#btn_card_move,
QPushButton#btn_card_cut,
QPushButton#btn_card_delete {
    background-color: transparent;
    border: 1px solid transparent;
    color: #8592A0;
    font-size: 13px;
    font-weight: 600;
    border-radius: 17px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
}

QPushButton#btn_card_move:hover,
QPushButton#btn_card_cut:hover {
    background-color: #EEF2F6;
    color: #1D3B53;
    border: 1px solid #DCE3EA;
}

QPushButton#btn_card_delete:hover {
    background-color: #FCEBEA;
    color: #B3261E;
    border: 1px solid #F3C9C6;
}

QPushButton#btn_card_move:disabled,
QPushButton#btn_card_cut:disabled,
QPushButton#btn_card_delete:disabled {
    background-color: transparent;
    border: 1px solid transparent;
    color: #D5DAE0;
}

/* ── BARRE DI AVANZAMENTO ───────────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 3px;
    background-color: #E4E7EB;
    max-height: 6px;
    min-height: 6px;
    text-align: center;
}

/* video in corso: blu notte — totale: arancio */
QProgressBar#pb_current::chunk {
    background-color: #1D3B53;
    border-radius: 3px;
}

QProgressBar#pb_global::chunk {
    background-color: #E8541E;
    border-radius: 3px;
}

/* ── LOG ────────────────────────────────────────────────────────────────── */
QTextEdit#log_box {
    background-color: #15293B;
    color: #DCE3EA;
    border: none;
    border-radius: 10px;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 12px;
    padding: 10px 12px;
    selection-background-color: #35536C;
}

/* ── SCROLLBAR ──────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD2D9;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #A7B1BC; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; border: none; background: none; }
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical { border: none; background: none; image: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #CBD2D9;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #A7B1BC; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; border: none; background: none; }
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal { border: none; background: none; image: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── FINESTRE DI DIALOGO ────────────────────────────────────────────────── */
QDialog,
QMessageBox {
    background-color: #FFFFFF;
}

QDialog QLabel,
QMessageBox QLabel {
    color: #1F2933;
    font-size: 13px;
}

/* Pulsanti generici delle finestre (OK, Annulla, Avvia, Esci...) */
QDialog QPushButton,
QMessageBox QPushButton {
    background-color: #EEF2F6;
    color: #1D3B53;
    border: 1px solid #DCE3EA;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
    min-width: 64px;
}
QDialog QPushButton:hover,
QMessageBox QPushButton:hover {
    background-color: #E2E9F0;
    border-color: #C5D0DB;
}
QDialog QPushButton:default,
QMessageBox QPushButton:default {
    background-color: #1D3B53;
    color: #FFFFFF;
    border: 1px solid #1D3B53;
}
QDialog QPushButton:default:hover,
QMessageBox QPushButton:default:hover {
    background-color: #2A4D6A;
}
QDialog QPushButton:disabled {
    background-color: #F0F3F6;
    color: #B8C0C9;
    border-color: #E4E7EB;
}

/* Salva (impostazioni, editor txt, data): azione principale della finestra */
QPushButton#btn_dlg_save,
QPushButton#btn_txt_save,
QPushButton#btn_date_save,
QPushButton#btn_save_date {
    background-color: #1D3B53;
    color: #FFFFFF;
    border: 1px solid #1D3B53;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton#btn_dlg_save:hover,
QPushButton#btn_txt_save:hover,
QPushButton#btn_date_save:hover,
QPushButton#btn_save_date:hover { background-color: #2A4D6A; }

QPushButton#btn_dlg_reset,
QPushButton#btn_dlg_cancel {
    background-color: #FFFFFF;
    color: #52606D;
    border: 1px solid #CBD2D9;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 400;
}
QPushButton#btn_dlg_reset:hover,
QPushButton#btn_dlg_cancel:hover { background-color: #F0F3F6; color: #1F2933; }

QLabel#lbl_dlg_filename {
    color: #8592A0;
    font-style: italic;
    font-size: 11px;
}

QLabel#lbl_dlg_error {
    color: #B3261E;
    font-size: 11px;
}

QWidget#settings_group {
    background-color: #F8F9FB;
    border: 1px solid #E4E7EB;
    border-radius: 10px;
}

QLabel#settings_group_title {
    color: #1D3B53;
    font-weight: 600;
    font-size: 13px;
}

QCheckBox {
    color: #1F2933;
    font-size: 13px;
    spacing: 8px;
}

/* Editor del txt e dei tagli manuali */
QTextEdit#txt_editor,
QPlainTextEdit {
    border: 1px solid #CBD2D9;
    border-radius: 8px;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 13px;
    color: #1F2933;
    background-color: #FFFFFF;
    selection-background-color: #1D3B53;
    selection-color: #FFFFFF;
}
QTextEdit#txt_editor:focus,
QPlainTextEdit:focus {
    border-color: #1D3B53;
}

/* Tabella dello storico */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FB;
    border: 1px solid #E4E7EB;
    border-radius: 8px;
    gridline-color: #EEF0F3;
    color: #1F2933;
    font-size: 12px;
    selection-background-color: #E2E9F0;
    selection-color: #1F2933;
}
QHeaderView::section {
    background-color: #F5F6F8;
    color: #52606D;
    border: none;
    border-bottom: 1px solid #E4E7EB;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 600;
}

/* ── BARRA DEGLI STRUMENTI DELLA CODA ───────────────────────────────────── */
QPushButton#btn_pill_left,
QPushButton#btn_pill_right {
    background-color: #FFFFFF;
    border: 1px solid #CBD2D9;
    color: #52606D;
    font-size: 14px;
    padding: 0;
}
QPushButton#btn_pill_left {
    border-right: none;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}
QPushButton#btn_pill_right {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QPushButton#btn_pill_left:hover,
QPushButton#btn_pill_right:hover {
    background-color: #F0F3F6;
}

QPushButton#btn_session {
    background-color: #FFFFFF;
    border: 1px solid #CBD2D9;
    color: #1F2933;
    font-size: 12px;
    font-weight: 600;
    border-radius: 8px;
    min-height: 28px;
    padding: 0 10px;
}
QPushButton#btn_session:hover {
    background-color: #F0F3F6;
}
QPushButton#btn_session:disabled {
    background-color: #F5F6F8;
    color: #B8C0C9;
    border-color: #E4E7EB;
}

QLabel#lbl_duration {
    color: #52606D;
    font-size: 12px;
    padding: 0 4px;
}

QPushButton#btn_expand_log {
    background-color: transparent;
    border: none;
    color: #8592A0;
    font-size: 14px;
    border-radius: 6px;
}
QPushButton#btn_expand_log:hover {
    background-color: #E4E7EB;
    color: #1F2933;
}
QPushButton#btn_expand_log:disabled {
    background-color: transparent;
    color: #B8C0C9;
}

QPushButton#btn_sort {
    background-color: #FFFFFF;
    border: 1px solid #CBD2D9;
    color: #52606D;
    font-size: 12px;
    border-radius: 8px;
    padding: 0 10px;
}
QPushButton#btn_sort:hover {
    background-color: #F0F3F6;
    color: #1F2933;
}
QPushButton#btn_sort:checked {
    background-color: #1D3B53;
    color: #FFFFFF;
    border-color: #1D3B53;
}
QPushButton#btn_sort:disabled {
    background-color: #F5F6F8;
    color: #B8C0C9;
    border-color: #E4E7EB;
}

/* ── PULSANTI DI SOLA ICONA ─────────────────────────────────────────────── */
/* Il disegno viene dal carattere di icone di Windows: il colore segue lo stile */
QPushButton#btn_card_move,
QPushButton#btn_card_cut,
QPushButton#btn_card_delete,
QPushButton#btn_pill_left,
QPushButton#btn_pill_right,
QPushButton#btn_expand_log,
QPushButton#btn_icona,
QPushButton#btn_icona_rossa {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", "Segoe UI Symbol";
    font-weight: 400;
}

QDialog QPushButton#btn_icona,
QDialog QPushButton#btn_icona_rossa {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #52606D;
    font-size: 13px;
    padding: 0px;
    min-width: 0px;
}
QDialog QPushButton#btn_icona:hover {
    background-color: #EEF2F6;
    color: #1D3B53;
    border: 1px solid #DCE3EA;
}
QDialog QPushButton#btn_icona_rossa:hover {
    background-color: #FCEBEA;
    color: #B3261E;
    border: 1px solid #F3C9C6;
}

QProgressBar::chunk {
    background-color: #1D3B53;
    border-radius: 3px;
}
